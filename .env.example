# Copia este archivo a ".env" y completa con tus datos reales.
# El ".env" real NUNCA debe subirse a git ni compartirse.

# --- Conexión a DirectAdmin ---
DA_HOST=mail.emapica.com.pe
DA_PORT=2222
DA_DOMAIN=emapica.com.pe
DA_USERNAME=tu_usuario_directadmin
DA_LOGIN_KEY=tu_login_key_aqui

# --- Servidor ---
PORT=3000

# --- Sesión de login ---
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Umbrales de alerta (porcentaje de uso) ---
THRESHOLD_WARNING=70
THRESHOLD_CRITICAL=90

# --- Sincronización automática (cron) ---
# Formato cron estándar. Por defecto: todos los días a las 7:00 am
SYNC_CRON=0 7 * * *
SYNC_AUTO_ENABLED=true
